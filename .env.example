# Copy to .env and fill in values
DATABASE_URL=postgresql://jtickets:jtickets_dev@localhost:5432/eventbooking
SECRET_KEY=change-me-to-a-long-random-string-in-production

# PostgreSQL connection pool / sync route threadpool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
THREADPOOL_SIZE=60

# POST /bookings admission control (seconds)
BOOKING_MAX_INFLIGHT=50
BOOKING_QUEUE_TIMEOUT=8
# Max seconds the outbox dispatcher defers emails while bookings are in flight
OUTBOX_MAX_DEFER_SECONDS=20

# Transactional email: console for dev; brevo for real delivery
EMAIL_PROVIDER=console
BREVO_API_KEY=replace-with-brevo-api-key
EMAIL_FROM=bookings@your-verified-domain.com
EMAIL_FROM_NAME=JTickets
EMAIL_SUPPRESS_DOMAINS=loadtest.jtickets.dev,example.com

# Alternative SMTP transport (STARTTLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password

# Comma-separated list of allowed browser origins (the deployed frontend URL).
# Defaults to local Vite dev servers when unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudflare R2 (optional — only needed for image uploads)
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_R2_ACCESS_KEY=your_r2_access_key_id
CF_R2_SECRET_KEY=your_r2_secret_access_key
CF_R2_BUCKET=jtickets
CF_R2_PUBLIC_URL=https://your-custom-domain.com   # optional, defaults to r2.dev URL
